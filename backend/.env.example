# Copie para .env e ajuste os valores antes de subir o container.

# IMPORTANTE: quando subido via docker-compose (FLASK_ENV=production é
# setado direto no docker-compose.yml pro serviço "backend"), o app se
# recusa a iniciar se SECRET_KEY continuar no valor padrão abaixo - ver
# app/__init__.py. Troque por um valor forte e aleatório antes de subir,
# ex.: `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# OBRIGATÓRIA (sem default - o container SEMPRE se recusa a subir sem
# isso, em qualquer ambiente): criptografa em repouso os dados pessoais de
# Lead (nome/telefone/e-mail/mensagem) - ver app/utils/crypto.py e
# app/models/lead.py. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GUARDE essa chave separada do backup do banco (ex.: gerenciador de
# segredos, cofre da equipe) - perdê-la torna os leads já salvos
# permanentemente ilegíveis; trocá-la sem migrar os dados antigos tem o
# mesmo efeito pros registros já existentes.
FIELD_ENCRYPTION_KEY=

# Retenção de leads (LGPD) - dias que um lead NÃO marcado como "convertido"
# no painel fica no banco antes de ficar elegível pro expurgo automático
# via `python purge_leads.py` (não roda sozinho, precisa de cron - ver
# DEPLOY-HOSTINGER.md). Lead marcado "convertido" nunca é expurgado.
LEAD_RETENTION_DAYS=180

# Preenchido automaticamente pelo docker-compose (aponta para o serviço "db").
# Só sobrescreva se for rodar o backend fora do compose.
DATABASE_URL=postgresql+psycopg2://alecrim:troque-a-senha@db:5432/alecrim

# Domínios que podem chamar a API (frontend em produção + dev local).
CORS_ORIGINS=http://localhost:3000,https://www.advocaciaalecrim.com.br

RATELIMIT_STORAGE_URI=memory://

# Notificação de novo lead por e-mail (opcional). Deixe em branco para desativar.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TO=alecrimrio@gmail.com

# Bootstrap do único admin do painel (/admin, login em /login). Só são lidas
# por `python seed.py` (ou `docker compose exec backend python seed.py`)
# quando a tabela admin_users ainda está vazia - depois da troca de senha
# pelo painel, essas variáveis viram só referência histórica e nunca mais
# são consultadas. Defina as duas, rode o seed (ou reinicie o container) e
# só então o login vai funcionar.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=troque-por-uma-senha-forte
