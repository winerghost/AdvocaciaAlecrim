# Variáveis usadas diretamente pelo docker-compose.yml.
# Copie para .env e ajuste antes de subir os containers.
# (backend/.env e frontend/.env também precisam existir - veja seus .env.example)

POSTGRES_USER=alecrim
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=alecrim

# Portas expostas em 127.0.0.1 na VPS (o Nginx do host aponta para elas).
BACKEND_PORT=8000
FRONTEND_PORT=3000

# URL pública da API - só usada se algo no client precisar chamá-la direto.
NEXT_PUBLIC_API_URL=https://www.advocaciaalecrim.com.br/api
