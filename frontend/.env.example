# Copie para .env e ajuste antes de subir o container.

# Usado só se algum código client-side precisar chamar a API diretamente.
# Hoje o formulário passa por app/api/leads/route.ts, então isso é opcional.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Usado pelo servidor Next (SSR + route handlers) dentro do docker-compose.
API_INTERNAL_URL=http://backend:8000

# URL pública canônica do site (sitemap, canonical e Open Graph do blog).
# Lida em runtime; sem barra no final. Default no código: o valor abaixo.
# SITE_URL=https://www.advocaciaalecrim.com.br
